# Copy to .env.local (gitignored). NEVER commit real values.
NODE_ENV=development
APP_URL=http://localhost:3000

# App role — NON-superuser, no BYPASSRLS. Used by the running app so it can
# never bypass RLS.
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/topbuilder

# Migration role — superuser/owner. Used by `pnpm migrate` ONLY.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/topbuilder

# --- set in S1+ (do not commit real values) ---
# GCP_PROJECT=builder-ai-497610
# IDENTITY_PLATFORM_API_KEY=
# SESSION_SIGNING_KEY=            # from Secret Manager
# KMS_KEY_NAME=projects/builder-ai-497610/locations/.../topbuilder/token-encryption-key

# --- comms: outbound + INBOUND ---------------------------------------------
# Resend (email) and Twilio (SMS). Without these the app degrades honestly:
# messages log as "no delivery channel" rather than claiming to have sent.
# RESEND_API_KEY=
# MAIL_FROM=support@topbuilderai.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=              # also verifies the INBOUND webhook signature
# TWILIO_FROM=                    # platform fallback; each tenant gets its own
#                                 # number in comms_settings.sms_number
#
# The URL Twilio is configured to POST inbound texts to. The signature covers
# it, and on Cloud Run `request.url` is the INTERNAL http:// address — so the
# public URL is rebuilt from APP_ORIGIN, and this overrides that if you front
# the app with a different hostname.
# TWILIO_WEBHOOK_URL=https://os.topbuilderai.com/api/webhooks/twilio/sms

# --- the polish helper (the ONE model call in this system) ------------------
# Absent = the Polish button does not render and the route 503s. Everything
# else in the product is deterministic and stays that way.
# ANTHROPIC_API_KEY=
# POLISH_MODEL=claude-haiku-4-5-20251001
